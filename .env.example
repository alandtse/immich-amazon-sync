# Immich (>= 3.2)

IMMICH_URL=http://immich-server:2283
# API key with exactly these permissions: album.read, asset.read, asset.download
IMMICH_API_KEY=your_immich_api_key

# Comma-separated album names (must match exactly as shown in Immich)
IMMICH_ALBUMS=Family,Vacation 2024

# Amazon Photos target

# Marketplace of your Amazon account: de (default), com, co.uk, fr, it, es, ...
AP_TLD=de
# Album in Amazon Photos that receives the photos (created if missing)
AP_ALBUM_NAME=Echo Show
# trash = remove from album and move to Amazon trash; album_only = only remove from album
AP_DELETE_MODE=trash

# accumulate keeps photos in Amazon Photos when they leave the selected Immich
# albums, giving Echo Show a larger pool to rotate. This also means deleting an
# asset from Immich does NOT remove the Amazon copy. Set to mirror for legacy
# behavior (remove from the Amazon album and, by default, move to trash).
SYNC_MODE=accumulate

# Accumulation pruning is opt-in. Options: none, max_count, keep_recent, both.
# max_count removes oldest retired photos until the total tracked set is <= this
# count; keep_recent removes retired photos not seen in Immich within this many days.
# both applies either rule. Source-album photos are never pruned.
PRUNE_MODE=none
# PRUNE_MAX_COUNT=1000
# PRUNE_KEEP_RECENT_DAYS=365

# Amazon Photos cookies (from your browser, see README)
#
# For amazon.de the cookie names are session-id, ubid-acbde and at-acbde.
# They are derived from AP_TLD; set AP_UBID_KEY / AP_AT_KEY only to override.
# Prefer the *_FILE variants (Docker secrets) so values don't show up in `docker inspect`.

AP_SESSION_ID=your_session_id
AP_UBID_VALUE=your_ubid_value
AP_AT_VALUE=your_at_value
# AP_SESSION_ID_FILE=/run/secrets/ap_session_id
# AP_UBID_VALUE_FILE=/run/secrets/ap_ubid_value
# AP_AT_VALUE_FILE=/run/secrets/ap_at_value
# IMMICH_API_KEY_FILE=/run/secrets/immich_api_key

# Use the User-Agent of the browser you copied the cookies from
# AP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36

# Safety

# Start with a dry run: logs planned uploads/deletions, writes nothing.
DRY_RUN=true
# Refuse to delete more than this share / number of tracked photos in one run
MAX_DELETE_FRACTION=0.2
MAX_DELETE_COUNT=50

# Misc

# IMAGE (default) or IMAGE,VIDEO
SYNC_TYPES=IMAGE
# Files larger than this are skipped
MAX_FILE_MB=200
SYNC_INTERVAL_HOURS=6
# Pinged (GET) after every fully successful run, e.g. healthchecks.io
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid
